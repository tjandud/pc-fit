#!/usr/bin/env node
const path = require('path');
require('dotenv').config({ path: path.join(__dirname, '../.env') });

const http = require('http');
const { Server } = require('socket.io');
const app = require('../src/app');
const { createSessionMiddleware } = require('../src/config/session');
const setupTakeoffSocket = require('../src/sockets/takeoffSocket');

// ENV 검증 (경고 모드)
const envVars = ['SUPABASE_URL','SUPABASE_SERVICE_KEY','OPENAI_API_KEY','NAVER_CLIENT_ID','NAVER_CLIENT_SECRET','YOUTUBE_API_KEY'];
envVars.forEach(v => {
  if (!process.env[v]) console.warn(`⚠️  [ENV] ${v} 미설정. 해당 기능 비활성.`);
});

const PORT = process.env.PORT || 3000;

async function start() {
  try {
    // HTTP + Socket.io
    const server = http.createServer(app);
    const allowedOrigins = (process.env.CLIENT_URL || 'http://localhost:8080')
      .split(',')
      .map(o => o.trim())
      .filter(Boolean);
    const io = new Server(server, {
      cors: {
        origin: (origin, callback) => {
          if (!origin) return callback(null, true);
          if (
            allowedOrigins.includes('*') ||
            allowedOrigins.includes(origin) ||
            origin.endsWith('.vercel.app') ||
            origin.endsWith('.onrender.com') ||
            origin.startsWith('http://localhost:')
          ) {
            return callback(null, true);
          }
          return callback(new Error(`Socket CORS blocked: ${origin}`));
        },
        methods: ['GET', 'POST'],
        credentials: true
      }
    });

    app.set('io', io);
    setupTakeoffSocket(io);

    server.listen(PORT, () => {
      console.log(`[PC-Fit] Server: http://localhost:${PORT}`);
    });
  } catch (err) {
    console.error('[FATAL]', err.message);
  }
}

start();